generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  username            String               @unique
  email               String?              @unique
  passwordHash        String               @map("password_hash")
  role                String
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  bills               Bill[]
  passwordResetTokens PasswordResetToken[]
  stockInRecords      StockInRecord[]

  @@map("users")
}

model Category {
  id               Int        @id @default(autoincrement())
  name             String
  department       String     @default("FURNITURE") @map("department") // "FURNITURE" | "ELECTRONICS"
  parentCategoryId Int?       @map("parent_category_id")
  isActive         Boolean    @default(true) @map("is_active")
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories    Category[] @relation("CategoryHierarchy")
  products         Product[]

  @@index([department, isActive])
  @@map("categories")
}

model Product {
  id                Int             @id @default(autoincrement())
  categoryId        Int             @map("category_id")
  department        String          @default("FURNITURE") @map("department") // "FURNITURE" | "ELECTRONICS"
  name              String
  barcode           String?         @unique
  brand             String?
  productType       String          @map("product_type")
  costPrice         Decimal         @map("cost_price")
  sellingPrice      Decimal         @map("selling_price")
  quantityInStock   Int             @default(0) @map("quantity_in_stock")
  lowStockThreshold Int             @default(5) @map("low_stock_threshold")
  warrantyMonths    Int?            @default(12) @map("warranty_months")
  imageUrl          String?         @map("image_url")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  billItems         BillItem[]
  bookingItems      BookingItem[]
  units             ProductUnit[]
  category          Category        @relation(fields: [categoryId], references: [id])
  stockInRecords    StockInRecord[]
  purchaseItems     PurchaseItem[]

  @@index([isActive, categoryId])
  @@index([department, isActive])
  @@index([name])
  @@index([brand])
  @@map("products")
}

model ProductUnit {
  id         Int        @id @default(autoincrement())
  productId  Int        @map("product_id")
  imeiNumber String     @unique @map("imei_number")
  status     String
  costPrice  Decimal    @map("cost_price")
  addedAt    DateTime   @default(now()) @map("added_at")
  soldAt     DateTime?  @map("sold_at")
  billItems  BillItem[]
  product    Product    @relation(fields: [productId], references: [id])

  @@index([productId, status])
  @@map("product_units")
}

model StockInRecord {
  id            Int       @id @default(autoincrement())
  productId     Int       @map("product_id")
  quantityAdded Int       @map("quantity_added")
  costPrice     Decimal   @map("cost_price")
  addedByUserId Int       @map("added_by_user_id")
  purchaseId    Int?      @map("purchase_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [addedByUserId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])

  @@map("stock_in_records")
}

model Customer {
  id       Int       @id @default(autoincrement())
  name     String?
  address  String?
  phone    String?
  bills    Bill[]
  bookings Booking[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

model Bill {
  id              Int            @id @default(autoincrement())
  billNumber      String         @unique @map("bill_number")
  billType        String         @default("REGULAR") @map("bill_type") // "REGULAR" | "DELIVERY_INVOICE"
  department      String         @default("FURNITURE") @map("department") // "FURNITURE" | "ELECTRONICS" | "COMBINED"
  bookingId       Int?           @map("booking_id")
  customerId      Int?           @map("customer_id")
  createdByUserId Int            @map("created_by_user_id")
  deliveryDate    DateTime?      @map("delivery_date")
  warrantyStarts  DateTime?      @map("warranty_starts")
  subtotal        Decimal
  discount        Decimal        @default(0)
  sgstPercent     Decimal        @default(0) @map("sgst_percent")
  cgstPercent     Decimal        @default(0) @map("cgst_percent")
  sgstAmount      Decimal        @default(0) @map("sgst_amount")
  cgstAmount      Decimal        @default(0) @map("cgst_amount")
  totalAmount     Decimal        @map("total_amount")
  paidAmount      Decimal        @default(0) @map("paid_amount")
  dueAmount       Decimal        @default(0) @map("due_amount")
  paymentStatus   String         @default("PAID") @map("payment_status")
  paymentMode     String         @map("payment_mode")
  status          String
  whatsappStatus  String?        @map("whatsapp_status")
  whatsappSentAt  DateTime?      @map("whatsapp_sent_at")
  isSettled       Boolean        @default(false) @map("is_settled")
  createdAt       DateTime       @default(now()) @map("created_at")
  billItems       BillItem[]
  bookingItems    BookingItem[]
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  user            User           @relation(fields: [createdByUserId], references: [id])
  customer        Customer?      @relation(fields: [customerId], references: [id])
  financeRecord   FinanceRecord?

  @@index([customerId])
  @@index([department, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("bills")
}

model BillItem {
  id             Int          @id @default(autoincrement())
  billId         Int          @map("bill_id")
  productId      Int          @map("product_id")
  productUnitId  Int?         @map("product_unit_id")
  quantity       Int
  mrp            Decimal?     @map("mrp")
  unitPrice      Decimal      @map("unit_price")
  lineTotal      Decimal      @map("line_total")
  customisations String?      @map("customisations")
  bill           Bill         @relation(fields: [billId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  productUnit    ProductUnit? @relation(fields: [productUnitId], references: [id])

  @@index([billId])
  @@index([productId])
  @@map("bill_items")
}

model Booking {
  id                   Int                @id @default(autoincrement())
  bookingNumber        String             @unique @map("booking_number")
  customerId           Int                @map("customer_id")
  eventDate            DateTime?          @map("event_date")
  expectedDeliveryDate DateTime           @map("expected_delivery_date")
  totalEstimatedAmount Decimal            @map("total_estimated_amount")
  advancePaid          Decimal            @default(0) @map("advance_paid")
  remainingBalance     Decimal            @default(0) @map("remaining_balance")
  status               String             @default("CONFIRMED") @map("status") // "CONFIRMED" | "PARTIALLY_DELIVERED" | "COMPLETED" | "CANCELLED"
  notes                String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  customer             Customer           @relation(fields: [customerId], references: [id])
  bills                Bill[]
  bookingItems         BookingItem[]
  deliveries           DeliverySchedule[]

  @@index([customerId])
  @@index([status])
  @@index([expectedDeliveryDate])
  @@map("bookings")
}

model BookingItem {
  id             Int      @id @default(autoincrement())
  bookingId      Int      @map("booking_id")
  productId      Int      @map("product_id")
  department     String   @map("department") // "FURNITURE" | "ELECTRONICS"
  quantity       Int
  mrp            Decimal? @map("mrp")
  unitPrice      Decimal  @map("unit_price")
  lineTotal      Decimal  @map("line_total")
  customisations String?  @map("customisations")
  isBilled       Boolean  @default(false) @map("is_billed")
  billId         Int?     @map("bill_id")
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  bill           Bill?    @relation(fields: [billId], references: [id])

  @@index([bookingId])
  @@index([productId])
  @@map("booking_items")
}

model DeliverySchedule {
  id             Int       @id @default(autoincrement())
  bookingId      Int       @map("booking_id")
  scheduledDate  DateTime  @map("scheduled_date")
  actualDelivery DateTime? @map("actual_delivery")
  status         String    @default("SCHEDULED") @map("status") // "SCHEDULED" | "OUT_FOR_DELIVERY" | "DELIVERED"
  driverNotes    String?   @map("driver_notes")
  createdAt      DateTime  @default(now()) @map("created_at")
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([scheduledDate, status])
  @@map("delivery_schedules")
}

model FinanceProvider {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  records   FinanceRecord[]

  @@map("finance_providers")
}

model FinanceRecord {
  id                Int             @id @default(autoincrement())
  billId            Int             @unique @map("bill_id")
  financeProviderId Int             @map("finance_provider_id")
  emiAmount         Decimal         @map("emi_amount")
  months            Int?
  createdAt         DateTime        @default(now()) @map("created_at")
  bill              Bill            @relation(fields: [billId], references: [id])
  financeProvider   FinanceProvider @relation(fields: [financeProviderId], references: [id])

  @@map("finance_records")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model WhatsappSettings {
  id                   Int     @id @default(autoincrement())
  ownerPhone           String  @default("6375591682") @map("owner_phone")
  status               String  @default("disconnected") @map("status")
  qrCode               String? @map("qr_code")
  simulateFailures     Boolean @default(false) @map("simulate_failures")
  simulateSessionError Boolean @default(false) @map("simulate_session_error")

  @@map("whatsapp_settings")
}

model WhatsappDelivery {
  id            Int       @id @default(autoincrement())
  billId        Int       @map("bill_id")
  billNumber    String    @map("bill_number")
  customerName  String    @map("customer_name")
  mobileNumber  String    @map("mobile_number")
  pdfPath       String    @map("pdf_path")
  customMessage String?   @map("custom_message")
  status        String    @default("pending")
  failureReason String?   @map("failure_reason")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("whatsapp_deliveries")
}

model WhatsappAuditLog {
  id         Int      @id @default(autoincrement())
  billId     Int      @map("bill_id")
  billNumber String   @map("bill_number")
  event      String
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("whatsapp_audit_logs")
}

model Vendor {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String
  address   String?
  gstin     String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  purchases Purchase[]

  @@index([phone])
  @@index([name])
  @@map("vendors")
}

model Purchase {
  id              Int               @id @default(autoincrement())
  purchaseNumber  String            @unique @map("purchase_number")
  vendorInvoiceNo String?           @map("vendor_invoice_no")
  vendorId        Int               @map("vendor_id")
  department      String            @default("FURNITURE") @map("department") // "FURNITURE" | "ELECTRONICS"
  purchaseDate    DateTime          @default(now()) @map("purchase_date")
  totalAmount     Decimal           @map("total_amount")
  paidAmount      Decimal           @default(0) @map("paid_amount")
  dueAmount       Decimal           @default(0) @map("due_amount")
  paymentStatus   String            @default("UNPAID") @map("payment_status") // "PAID" | "PARTIAL" | "UNPAID"
  isStockAdded    Boolean           @default(true) @map("is_stock_added")
  notes           String?
  createdByUserId Int?              @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  vendor          Vendor            @relation(fields: [vendorId], references: [id])
  items           PurchaseItem[]
  payments        PurchasePayment[]
  stockInRecords  StockInRecord[]

  @@index([vendorId])
  @@index([paymentStatus])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id             Int      @id @default(autoincrement())
  purchaseId     Int      @map("purchase_id")
  productId      Int?     @map("product_id")
  itemName       String   @map("item_name")
  quantity       Int
  unitCostPrice  Decimal  @map("unit_cost_price")
  lineTotal      Decimal  @map("line_total")
  serialNumbers  String?  @map("serial_numbers")
  warrantyMonths Int?     @map("warranty_months")
  createdAt      DateTime @default(now()) @map("created_at")
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchasePayment {
  id             Int      @id @default(autoincrement())
  purchaseId     Int      @map("purchase_id")
  amountPaid     Decimal  @map("amount_paid")
  paymentDate    DateTime @default(now()) @map("payment_date")
  paymentMode    String   @default("CASH") @map("payment_mode") // "CASH" | "UPI" | "BANK_TRANSFER" | "CHEQUE"
  transactionRef String?  @map("transaction_ref")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_payments")
}
